        "\n",
        "from sklearn.tree import plot_tree\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.figure(figsize=(20, 10))\n",
        "\n",
        "plot_tree(\n",
        "    rf.estimators_[50],\n",
        "    max_depth=3,\n",
        "    feature_names=X.columns,\n",
        "    class_names=[\"Normal\", \"Fraud\"],\n",
        "    filled=True\n",
        ")\n",
        "\n",
        "plt.show()"
