          ]
        }
      ],
      "source": [
        "\n",
        "linear_svm = SVC(\n",
        "    kernel=\"linear\",\n",
        "    C=1\n",
        ")\n",
        "\n",
        "linear_svm.fit(X_train_scaled, y_train)\n",
        "\n",
        "linear_pred = linear_svm.predict(X_test_scaled)\n",
        "\n",
        "print(\"LINEAR SVM\")\n",
        "print(\"Accuracy:\", accuracy_score(y_test, linear_pred))\n",
        "print(classification_report(y_test, linear_pred))"
      ]
    },
